# Engine environment variables (all optional).
# Copy this file to .env and fill in your own values. .env is gitignored: never commit real keys.
# The engine only reads public Polymarket prices; it needs no wallet or trading credentials.

# Paths to the simulator outputs (defaults: next to this folder, then ../predictor/data/processed/)
# SIM_PROBS_PATH=/path/to/sim_probabilities.json
# MATCH_PROBS_PATH=/path/to/match_probabilities.json
# SIM_MATRIX_PATH=/path/to/sim_outcome_matrix.npz
# SIM_MATRIX_IDS_PATH=/path/to/sim_outcome_matrix_ids.json
